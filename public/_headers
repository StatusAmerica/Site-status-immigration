# Cache long-lived, imutáveis para assets com hash gerados pelo Vite/TanStack
# (inclui fontes @fontsource e imagens importadas de src/assets).
# HTML permanece sem cache para deploys refletirem imediatamente.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Arquivos herdados do armazenamento da Lovable (logo, OG, vídeo do hero).
/__l5e/*
  Cache-Control: public, max-age=31536000, immutable

# Vídeos em MP4 otimizados e posters
/videos/*
  Cache-Control: public, max-age=31536000, immutable

